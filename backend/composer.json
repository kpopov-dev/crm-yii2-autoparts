{
    "name": "kirill-popov/crm-backend",
    "description": "Backend модуль CRM на Yii2",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "stable",
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "ext-pdo": "*",
        "yiisoft/yii2": "^2.0.51",
        "firebase/php-jwt": "^6.10",
        "php-amqplib/php-amqplib": "^3.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.11",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "app\\": ""
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse",
        "cs": "phpcs --standard=PSR12 --ignore=vendor,runtime,web/assets .",
        "cs-fix": "phpcbf --standard=PSR12 --ignore=vendor,runtime,web/assets ."
    }
}
